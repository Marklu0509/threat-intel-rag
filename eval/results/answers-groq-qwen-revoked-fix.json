      "id": "8-02",
      "category": "revoked_id",
      "question": "What is T1093?",
      "expected": "answer",
      "gold": "T1055.012:overview",
      "model": "qwen/qwen3.8-27b",
      "error": "",
      "status": "answered",
      "refused_by": null,
      "refusal_reason": "",
      "claims": [
        {
          "text": "T1055.012 是 T1055 程序注入的子技術，稱為程序掏空（Process Hollowing）。",
          "passage_ids": [
            "T1055.012:overview"
          ]
        },
        {
          "text": "攻擊者可能將惡意代碼注入到已掛起並被掏空的程序中，以規避基於程序的防禦。",
          "passage_ids": [
            "T1055.012:overview"
          ]
        },
        {
          "text": "程序掏空是一種在另一個存活程序的地址空間中執行任意代碼的方法。",
          "passage_ids": [
            "T1055.012:overview"
          ]
        },
        {
          "text": "該技術通常通過創建處於掛起狀態的程序，然後解除映射/掏空其內存，並用惡意代碼替換來實現。",
          "passage_ids": [
            "T1055.012:overview"
          ]
        },
        {
          "text": "T1055.012 對應的戰術為隱蔽（Stealth）和特權提升（Privilege Escalation）。",
          "passage_ids": [
            "T1055.012:overview"
          ]
        },
        {
          "text": "T1055.012 僅適用於 Windows 平台。",
          "passage_ids": [
            "T1055.012:overview"
          ]
        }
      ],
